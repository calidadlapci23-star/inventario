rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regla general para la mayoría de las colecciones:
    // Permite leer y escribir a cualquier usuario autenticado.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }

    // Colecciones específicas con la misma regla para mayor claridad.
    // Esto cubre todas las operaciones (get, list, create, update, delete).

    match /productos/{productoId} {
      allow read, write: if request.auth != null;
    }

    match /proveedores/{proveedorId} {
      allow read, write: if request.auth != null;
    }

    match /solicitudes/{solicitudId} {
      allow read, write: if request.auth != null;
    }

    match /ordenes_compra/{ordenId} {
      allow read, write: if request.auth != null;
    }

    match /historial/{historialId} {
      allow read, write: if request.auth != null;
    }

    match /recepciones/{recepcionId} {
      allow read, write: if request.auth != null;
    }

    match /evaluaciones_proveedores/{evaluacionId} {
      allow read, write: if request.auth != null;
    }

    match /movimientos_inventario/{movimientoId} {
      allow read, write: if request.auth != null;
    }

    match /tareas/{tareaId} {
      allow read, write: if request.auth != null;
    }

    match /disciplinas/{docId} {
      allow read, write: if request.auth != null;
    }

    match /lotes/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
